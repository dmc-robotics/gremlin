# Grot configuration for the MacServitor test sketch

[basic]
cli_path = "arduino-cli"
fqbn = "teensy:avr:teensy41"  # run 'grot boards' for options
sketch_path = "."

[interface]
baud_rate = 115200

[teensy]
# Upload uses teensy_loader_cli; press the program button when loading
loader_path = "teensy_loader_cli"
